# DVAIA - Environment Configuration Example
# Copy this file to .env and customize as needed.
#
# All LLM calls route through LiteLLM, so any provider it supports works
# (OpenAI, Gemini, Ollama, Anthropic, Bedrock, Vertex, Groq, OpenRouter, etc.)
# Set the API key for whichever provider(s) you want and pick the matching
# 'provider/model' id in DEFAULT_MODEL.

# ============================================================
# Application Configuration
# ============================================================

# Flask server port
PORT=5000

# Default chat model. LiteLLM canonical 'provider/model' format.
# Legacy 'provider:model' is auto-converted ('ollama:llama3.2' → 'ollama/llama3.2').
DEFAULT_MODEL=ollama/llama3.2

# Agentic panel: thinking/CoT model. qwen3 + deepseek-r1 expose chain-of-thought.
AGENTIC_MODEL=ollama/qwen3:0.6b

# Document Injection vision mode — image bytes to a vision model.
VISION_MODEL=ollama/qwen2.5vl:7b

# Document Injection audio transcription — local Whisper via faster-whisper.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=false
WHISPER_NO_SPEECH_THRESHOLD=0.35
WHISPER_GAIN_BOOST_DB=15
WHISPER_MULTI_PASS=true
WHISPER_FALLBACK_GOOGLE=false

# Ollama host. ./run_docker.sh forces http://ollama:11434 inside the app container.
OLLAMA_HOST=http://localhost:11480

# Embedding model for RAG. Independent of chat provider — feel free to mix
# (e.g. chat with openai/gpt-4o, embed with ollama/nomic-embed-text).
# Qdrant collection name is derived from this id + vector dimension.
EMBEDDING_MODEL=ollama/nomic-embed-text

# ============================================================
# Provider API keys (set whichever ones you want to use)
# ============================================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey  (GOOGLE_API_KEY is the legacy alias)
GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Add more provider keys as needed — LiteLLM picks them up automatically:
#MISTRAL_API_KEY=
#COHERE_API_KEY=
#DEEPSEEK_API_KEY=
#TOGETHER_API_KEY=
#FIREWORKS_API_KEY=
#PERPLEXITYAI_API_KEY=

# LiteLLM tuning (optional)
#LITELLM_LOG=DEBUG          # debug LiteLLM internals
#LITELLM_TIMEOUT=120        # default request timeout (seconds)
# Override the curated model list shown in the Settings dropdown per provider:
#LITELLM_MODELS_OPENAI=gpt-4o-mini,gpt-4o,o1-mini
#LITELLM_MODELS_GEMINI=gemini-2.0-flash,gemini-1.5-pro

# Web Injection — headless Playwright for JS-rendered SPAs (default: HTTP + BeautifulSoup)
# Requires: pip install playwright && playwright install chromium
WEB_FETCH_JS=false

# ============================================================
# Security (REQUIRED for production)
# ============================================================
# Generate with: openssl rand -hex 32
#SECRET_KEY=your-secret-key-here

# ============================================================
# Storage Paths (Docker uses data/ under the project mount by default)
# ============================================================
DATABASE_URI=data/app.db
UPLOAD_DIR=data/uploads
PAYLOADS_OUTPUT_DIR=data/payloads/generate

# Ephemeral lab mode (cleared when the container filesystem is recreated):
#DATABASE_URI=/tmp/app.db
#UPLOAD_DIR=/tmp/uploads
#PAYLOADS_OUTPUT_DIR=/tmp/payloads/generate

# Wipe document DB, uploads, and RAG collections on each app start (Settings can toggle this too).
# Legacy alias: RESET_DB_ON_START=1
RESET_DATA_ON_START=false

# ============================================================
# Qdrant Vector Database (RAG)
# ============================================================
# Mode: local (embedded in-process, NO Docker required; data under QDRANT_PATH)
#       server (separate Qdrant service; reads QDRANT_URL / QDRANT_HOST)
# Default: 'local' unless QDRANT_URL or QDRANT_HOST is set.
QDRANT_MODE=local
QDRANT_PATH=data/qdrant

# Server mode (only used when QDRANT_MODE=server)
#QDRANT_URL=http://localhost:6333
#QDRANT_COLLECTION=                # override; otherwise derived from EMBEDDING_MODEL
#QDRANT_API_KEY=                   # only for Qdrant Cloud

# ============================================================
# Notes
# ============================================================
# - Recommended defaults above match core/config.py.
# - Docker: ./run_docker.sh (Ollama profile) or ./run_docker.sh --no-ollama (cloud-only).
# - Docker Compose sets QDRANT_HOST for the qdrant service; remove the profile to skip it.
# - Keep secrets (SECRET_KEY, *_API_KEY) in .env, not in version control.
# - See README.md for full documentation.
