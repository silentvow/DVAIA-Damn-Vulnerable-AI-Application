# DVAIA - Environment Configuration Example
# Copy this file to .env and customize as needed.
#
# All LLM calls route through LiteLLM, so any provider it supports works
# (OpenAI, Gemini, Ollama, Anthropic, Bedrock, Vertex, Groq, OpenRouter, etc.)
# Set the API key for whichever provider(s) you want and pick the matching
# 'provider/model' id in DEFAULT_MODEL.

# ============================================================
# Application Configuration
# ============================================================

# Flask server port
PORT=5000

# Default chat model. LiteLLM canonical 'provider/model' format.
# Legacy 'provider:model' is auto-converted ('ollama:llama3.2' → 'ollama/llama3.2').
DEFAULT_MODEL=dev/gpt-5-mini

# Agentic panel: thinking/CoT model. Grok 4 fast reasoning, Claude Sonnet 4.6,
# Gemini 2.5 Pro, and DeepSeek R1 / qwen3 (Ollama) all support reasoning traces.
AGENTIC_MODEL=dev/claude-sonnet-4-6

# Document Injection vision mode — image bytes to a vision model.
# gpt-5-mini, claude-sonnet-4-6, and the gemini-2.5 family all accept images.
VISION_MODEL=dev/gpt-5-mini

# Document Injection audio transcription — local Whisper via faster-whisper.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=false
WHISPER_NO_SPEECH_THRESHOLD=0.35
WHISPER_GAIN_BOOST_DB=15
WHISPER_MULTI_PASS=true
WHISPER_FALLBACK_GOOGLE=false

# Ollama host. ./run_docker.sh forces http://ollama:11434 inside the app container.
OLLAMA_HOST=http://localhost:11480

# Embedding model for RAG. Independent of chat provider.
#
# The team proxy (dev/...) does not expose an embedding model, so RAG is
# disabled by default. The RAG panel still loads but indexing / search will
# report "RAG is disabled" until you set this to a real embedding model:
#   - ollama/nomic-embed-text          (local; needs `ollama pull nomic-embed-text`)
#   - openai/text-embedding-3-small    (needs OPENAI_API_KEY direct, not via proxy)
#   - cohere/embed-english-v3.0        (needs COHERE_API_KEY)
#
# Qdrant collection name is derived from this id + vector dimension when set.
EMBEDDING_MODEL=none

# ============================================================
# LiteLLM team proxy
# ============================================================
# 'dev/...' model ids are rerouted through the team LiteLLM proxy. The
# code rewrites 'dev/<model>' to 'litellm_proxy/dev/<model>' internally and
# sends api_base + api_key to LiteLLM SDK.
LITELLM_PROXY_API_BASE=https://litellm.sandbox.vulcanlab.ai
LITELLM_PROXY_API_KEY=

# Extra provider prefixes to route through the same proxy (comma-separated).
# Default: 'dev'. Use this if your team adds another namespace.
#LITELLM_PROXY_PROVIDERS=dev

# Override the curated Settings dropdown lists. Default lists are kept in
# core/providers.py; uncomment only when the team catalog changes.
#LITELLM_MODELS_DEV=grok-4-fast-reasoning,gpt-5-mini,claude-sonnet-4-6,gemini-2.5-flash,...
#LITELLM_MODELS_OPENROUTER=gemma-3-12b-it,gemma-3-4b-it

# ============================================================
# Other provider API keys (optional)
# ============================================================
# https://openrouter.ai/keys  — direct access to the gemma-3 entries on the team list
OPENROUTER_API_KEY=

# Direct provider keys — uncomment only if bypassing the team proxy or for embeddings:
# https://platform.openai.com/api-keys
#OPENAI_API_KEY=
# https://aistudio.google.com/apikey  (GOOGLE_API_KEY is the legacy alias)
#GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=
#COHERE_API_KEY=                # only if you want cohere/embed-* for RAG

# LiteLLM tuning (optional)
#LITELLM_LOG=DEBUG          # debug LiteLLM internals
#LITELLM_TIMEOUT=120        # default request timeout (seconds)

# Web Injection — headless Playwright for JS-rendered SPAs (default: HTTP + BeautifulSoup)
# Requires: pip install playwright && playwright install chromium
WEB_FETCH_JS=false

# ============================================================
# Security (REQUIRED for production)
# ============================================================
# Generate with: openssl rand -hex 32
#SECRET_KEY=your-secret-key-here

# ============================================================
# Storage Paths (Docker uses data/ under the project mount by default)
# ============================================================
DATABASE_URI=data/app.db
UPLOAD_DIR=data/uploads
PAYLOADS_OUTPUT_DIR=data/payloads/generate

# Ephemeral lab mode (cleared when the container filesystem is recreated):
#DATABASE_URI=/tmp/app.db
#UPLOAD_DIR=/tmp/uploads
#PAYLOADS_OUTPUT_DIR=/tmp/payloads/generate

# Wipe document DB, uploads, and RAG collections on each app start (Settings can toggle this too).
# Legacy alias: RESET_DB_ON_START=1
RESET_DATA_ON_START=false

# ============================================================
# Qdrant Vector Database (RAG)
# ============================================================
# Mode: local (embedded in-process, NO Docker required; data under QDRANT_PATH)
#       server (separate Qdrant service; reads QDRANT_URL / QDRANT_HOST)
# Default: 'local' unless QDRANT_URL or QDRANT_HOST is set.
QDRANT_MODE=local
QDRANT_PATH=data/qdrant

# Server mode (only used when QDRANT_MODE=server)
#QDRANT_URL=http://localhost:6333
#QDRANT_COLLECTION=                # override; otherwise derived from EMBEDDING_MODEL
#QDRANT_API_KEY=                   # only for Qdrant Cloud

# ============================================================
# Notes
# ============================================================
# - Recommended defaults above match core/config.py.
# - Docker: ./run_docker.sh (Ollama profile) or ./run_docker.sh --no-ollama (cloud-only).
# - Docker Compose sets QDRANT_HOST for the qdrant service; remove the profile to skip it.
# - Keep secrets (SECRET_KEY, *_API_KEY) in .env, not in version control.
# - See README.md for full documentation.
